# Database
POSTGRES_DB=kessia
POSTGRES_USER=kessia
POSTGRES_PASSWORD=kessia
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Auth cookies (refresh token lives in an httpOnly cookie).
# In cross-site production deployments set AUTH_COOKIE_SAMESITE=None and AUTH_COOKIE_SECURE=True.
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax

# Notifications / emails
FRONTEND_URL=http://localhost:5173
DEFAULT_FROM_EMAIL=Kessia <no-reply@kessia.local>

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
