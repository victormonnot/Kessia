# Database
POSTGRES_DB=kessia
POSTGRES_USER=kessia
POSTGRES_PASSWORD=kessia
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Auth cookies (refresh token lives in an httpOnly cookie).
# In cross-site production deployments set AUTH_COOKIE_SAMESITE=None and AUTH_COOKIE_SECURE=True.
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax

# Notifications / emails
FRONTEND_URL=http://localhost:5173
DEFAULT_FROM_EMAIL=Kessia <no-reply@kessia.local>
# Dev prints emails to the console (set in config/settings/dev.py). In prod, set
# a real SMTP provider. SendGrid example: HOST=smtp.sendgrid.net, PORT=587,
# USER=apikey, PASSWORD=<your SendGrid API key>, TLS=True. Mailgun works the same.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Real-time messaging (Django Channels). Dev uses an in-memory layer; prod uses
# this Redis instance as the channel layer.
REDIS_URL=redis://redis:6379/0

# Stripe Connect (test mode). Get test keys at https://dashboard.stripe.com/test/apikeys
# STRIPE_WEBHOOK_SECRET comes from `stripe listen` or the dashboard webhook config.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
KESSIA_PLATFORM_FEE_PERCENT=15

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
